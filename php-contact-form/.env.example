# Usable with `docker run --env-file .env`. Comments must stay on their own lines.
COMPANY_NAME=Atlas Serviços Técnicos

# Optional e-mail notification. Without SMTP_HOST messages are only stored in the inbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# tls (STARTTLS, port 587), ssl (port 465) or none (local relay only)
SMTP_ENCRYPTION=tls
SMTP_USERNAME=contato@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=no-reply@example.com
MAIL_TO=contato@example.com

# Anti-abuse: messages per IP per window (seconds) and minimum seconds to fill the form
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600
MIN_FILL_SECONDS=3
# Comma-separated proxy addresses allowed to set X-Forwarded-For (e.g. your load balancer)
TRUSTED_PROXIES=
